x<-1:26           #setting objectives of x
y<-log(x)         #setting objectives of y
z<-letters[1:26]  #setting objectives of z in small letters
z<-LETTERS[1:26]  #setting objective of z in capital letters

today<-data.frame(x,y,z)       #creating dataframe of x,y,z
install.packages("gganimate")  #install packages(gganimate)
library(ggplot2)               #call a package(ggplot2)
library(gganimate)             #call a package(gganimate)
install.packages("gifski")     #install packages(gifski)
library(gifski)                #call a package(gifski)
p<-ggplot(data=today)          #step 1= object of graph
p<-p+aes(x=x,y=y)              # defining only axis here
p<-p+geom_point(size=4,alpha=0.5)  #size of plot will be 4 and transparency is alpha(0.5)
p<-p+geom_point(size=1,alpha=1)    #size of plot will be 4 and transparency is alpha(1)
ani_p<-p+transition_manual(x,cumulative=FALSE) #step 2 = animation:transition along x axis and only one point is visible becoz cumulative = FALSE
animate(ani_p,renderer=gifski_renderer())      #display
p<-p+geom_point(size=x,alpha=0.5)             #bubble plot: where the size of plot increases with any variablewhere the size of plot increases with any variable
ani_p<-p+tranistion_manual(x,cumulative=TRUE) #all points will be visible together
animate(ani_p,renderer=gifski_renderer())      #display
